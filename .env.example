# Flask Configuration
# Copy this file to .env and update with your settings

# IMPORTANT: Set to False in production!
FLASK_DEBUG=False

# Host to bind to (use 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces)
# For security, use 127.0.0.1 unless you need network access
FLASK_HOST=127.0.0.1

# Port to run the application
FLASK_PORT=5001

# Allowed CORS origins (comma-separated list)
# Add your frontend URL if running separately
ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Database path (optional, defaults to ./portfolio.db)
DATABASE_PATH=./portfolio.db
